// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(uuid())
  nome          String
  email         String
  whatsapp      String
  
  // Novos campos do orçamento
  norma         String
  paginas       Int
  prazo         Int      // Guarda o valor base do prazo escolhido
  revisao       Boolean  @default(false)
  plagio        Boolean  @default(false)
  ia            Boolean  @default(false)
  valorEstimado Float    // Guarda o valor total calculado
  comentarios   String?  // O sinal de interrogação indica que é opcional
  
  createdAt     DateTime @default(now())
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  otpHash   String   // Armazena apenas o hash, nunca o código puro
  attempts  Int      @default(0) // Controle de limite de tentativas
  expiresAt DateTime // Controle de expiração
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}